{
  "name": "ktauchert/mvc-framework",
  "description": "PHP MVC with file-based routes and PHP views",
  "type": "project",
  "require": {
    "php": ">=8.4",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "vlucas/phpdotenv": "^5.7"
  },
  "autoload": {
    "psr-4": {
      "Framework\\": "Framework/",
      "Api\\": "src/api/"
    },
    "classmap": [
      "src/app/"
    ],
    "files": [
      "Framework/helpers/autoload.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "serve": "php -S localhost:8000 -t public public/router.php",
    "test": "@php vendor/bin/phpunit",
    "make-route": "php scripts/make-route.php",
    "assets": "sass src/styles/app.scss public/css/app.css",
    "assets:watch": "sass --watch src/styles/app.scss public/css/app.css"
  },
  "config": {
    "sort-packages": true
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  }
}
