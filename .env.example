# Copy to .env and adjust. Never commit .env.

APP_ENV=local
APP_DEBUG=true

POSTGRES_DB=mvc
POSTGRES_USER=mvc
POSTGRES_PASSWORD=change_me

# PHP on the host (later). Same server as the published port.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=mvc
DB_USERNAME=mvc
DB_PASSWORD=change_me

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
